# Backend environment variables
# Copy this to .env and fill in your values.
# NEVER commit .env to source control.

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get your free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name. See https://aistudio.google.com/apikey for options.
# gemini-4-hydrogen is the current default in the official quickstart.
# The new "authorization" API keys (starting with "AQ.") are fully supported.
GEMINI_MODEL=gemini-3.8-flash

# ── Supabase (optional) ───────────────────────────────────────────────────────
# If not set, the backend works in stateless mode (sessions not persisted server-side).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# For local dev: http://localhost:5173
# For production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App settings ──────────────────────────────────────────────────────────────
# Set to "development" or "production"
ENVIRONMENT=development

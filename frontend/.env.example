# Frontend environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.

# URL of the FastAPI backend
# Local dev: leave empty (Vite proxy handles /api routes automatically)
# Production: set to your Render backend URL
VITE_API_BASE_URL=https://preppilot-ai-backend-zkqf.onrender.com

# Supabase (optional — app works with local storage if not set)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
